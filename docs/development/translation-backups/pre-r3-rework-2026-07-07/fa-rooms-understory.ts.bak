// Farsi translation of the v2 Act V (understory) room prose (beats, choice
// text/hint/outcome, field notes) for: the-archive, the-unchosen, the-echo.
// Registered under version 'v2'. See fa-rooms.ts for the established pattern
// this file follows. NOTE: each room's RunState-dependent beats (the
// exhibit card, the unchosen-doors list/opener, the echo's voice/junction/
// ending lines) are functions — those live in fa-dynamic.ts, not here.
import { registerAll } from './resolver';
import {
  roomBeatKey,
  roomChoiceHintKey,
  roomChoiceOutcomeKey,
  roomChoiceTextKey,
  roomNoteBodyKey,
  roomNoteThinkersKey,
  roomNoteTitleKey,
} from './keys';

// ---------- Act V: The Archive ----------
registerAll('v2', 'fa', {
  [roomBeatKey('the-archive', 0, 0)]: 'از پله‌ای که حق حضور اینجا را ندارد، پایین، به اتاقی بلند و کوتاه که با جعبه‌های خاکستریِ یکسان ردیف شده — دیواری کامل از آن‌ها، هرکدام با خطی آن‌قدر منظم که نمی‌تواند مال کسی جز خودِ این مجموعه باشد.',
  [roomBeatKey('the-archive', 0, 1)]: 'یک قفسه جعبه‌ای تازه‌تر و تنها دارد: مال شما. با تاریخی برچسب خورده که آن را پایانی می‌شناسید، و زیرش، با حروف ریزتر: کامل. بایگانی‌شده. فراموش‌نشده.',
  [roomBeatKey('the-archive', 0, 2)]: 'کنار آن، روی میز مطالعه، یک جعبه از قبل باز است — کسی، یا چیزی، پیش از رسیدن شما این را انتخاب کرده — و درونش، کارتی، تایپ‌شده، که یک لحظه از راهی که قبلاً تمام کرده‌اید را نقل می‌کند.',
  [roomBeatKey('the-archive', 0, 4)]: 'منگنه‌شده به جعبه، فرم پذیرشی هنوز توصیفی را حمل می‌کند که زمانی از خودتان دادید: «{blurb}» مجموعه آن را بی‌هیچ نظری بایگانی کرد، که یا احترام است یا خطای بایگانی؛ از اینجا هر دو یکسان به‌نظر می‌رسند.',
  [roomBeatKey('the-archive', 0, 5)]: 'نگهبان: (از درگاه، کلاه زیر بغل) زیاد به اینجا نمی‌آیم. ممنوع نیست — اینجا هیچ‌چیز ممنوع نیست — فقط این‌طور است که بیشتر مسافران فقط یک‌بار می‌خواهند اینجا بیایند، اگر اصلاً بخواهند. بایگانی برایش فرقی نمی‌کند. جای دیگری برای رفتن ندارد.',
  [roomChoiceTextKey('the-archive', 'stand-by-it')]: '«آن من بودم. قبولش می‌کنم — همه‌اش را.» خودتان کارت را زیر متن چاپی امضا کنید.',
  [roomChoiceHintKey('the-archive', 'stand-by-it')]: 'قبولش کنید — سخت‌ترین نوع امضا.',
  [roomChoiceOutcomeKey('the-archive', 'stand-by-it', 0)]: 'خودکار زنجیرشده به قفسه را برمی‌دارید و زیر خط تایپ‌شده، با دست خودتان امضا می‌کنید، که به‌نظر می‌رسد جعبه منتظرش بوده.',
  [roomChoiceOutcomeKey('the-archive', 'stand-by-it', 1)]: 'نگهبان: هر مسافری امضا نمی‌کند. بیشترشان کارت را می‌خوانند، جمع می‌شوند، و عقب می‌روند، انگار جوهر هنوز به‌قدر کافی تر است که بشود تغییرش داد. شما نامتان را به تصمیمی اضافه کردید که از قبل اتفاق افتاده. نمی‌دانم این چه هزینه‌ای دارد. می‌دانم که هیچ نیست، نیست.',
  [roomChoiceTextKey('the-archive', 'disown-it')]: '«این دیگر شبیه من نیست.» کارت را بدون امضا رها کنید و از جعبه عقب بروید.',
  [roomChoiceHintKey('the-archive', 'disown-it')]: 'بگذارید آن فاصله واقعی باشد، نه فقط راحت.',
  [roomChoiceOutcomeKey('the-archive', 'disown-it', 0)]: 'کارت را دقیقاً همان‌طور که پیدایش کردید رها می‌کنید و یک قدم کامل از قفسه عقب می‌روید، همان‌طور که از غریبه‌ای عقب می‌روید که تصادفاً هم‌اندازه‌ی کت شماست.',
  [roomChoiceOutcomeKey('the-archive', 'disown-it', 1)]: 'نگهبان: پرونده با شما بحث نمی‌کند. به‌ندرت این کار را می‌کند. فقط آنچه اتفاق افتاده را نگه می‌دارد، بایگانی‌شده زیر تاریخی که اتفاق افتاده — چه دستی که آن را انجام داد هنوز به نام شما پاسخ دهد، چه ندهد.',
  [roomChoiceTextKey('the-archive', 'refile-it')]: 'جعبه را آرام، بدون هیچ نظری له یا علیه، ببندید و سرجایش روی قفسه برگردانید.',
  [roomChoiceHintKey('the-archive', 'refile-it')]: 'نه از آن دفاع کنید، نه انکارش کنید. بایگانی‌اش کنید.',
  [roomChoiceOutcomeKey('the-archive', 'refile-it', 0)]: 'درپوش را با احتیاط می‌بندید، همان‌طور که کتابی را وسط جمله می‌بندید از سرِ احترام به یک فصل، نه موافقت با آن، و آن را به‌جای خودش میان همه‌ی بقیه برمی‌گردانید.',
  [roomChoiceOutcomeKey('the-archive', 'refile-it', 1)]: 'نگهبان: فکر می‌کنم هدف واقعی آن قفسه همین است. نه حکمی له یا علیه — جایی برای گذاشتن چیزی، بی‌آنکه لازم باشد تصمیم‌گیری درباره‌ی اینکه چه بود را تمام کرده باشید.',
  [roomChoiceTextKey('the-archive', 'pin-the-corner')]: 'گوشه‌ی نسوخته‌ی عکس را به لبه‌ی جعبه‌ی باز سنجاق کنید — الحاقیه‌ای به پرونده.',
  [roomChoiceHintKey('the-archive', 'pin-the-corner')]: 'به‌جای امضاکردن یا ردکردن، چیزی به پرونده اضافه کنید.',
  [roomChoiceOutcomeKey('the-archive', 'pin-the-corner', 0)]: 'گوشه‌ی کوچک کنده‌شده را با انگشت شست به کارت فشار می‌دهید تا بچسبد، الحاقیه‌ای که هیچ‌کس از شما نخواسته و هیچ‌کس هم از شما توضیحش را نخواهد خواست.',
  [roomChoiceOutcomeKey('the-archive', 'pin-the-corner', 1)]: 'بایگانی آن را دقیقاً همان‌طور می‌پذیرد که بایگانی‌ها همه‌چیز را می‌پذیرند — بی‌هیچ نظری، بی‌هیچ اعتراضی، و، متوجه می‌شوید، بی‌آنکه هرگز واقعاً به آن نیاز داشته باشد.',
  [roomNoteTitleKey('the-archive')]: 'درباره‌ی نگه‌داشتن سوابق',
  [roomNoteThinkersKey('the-archive')]: 'پل ریکور، هویت روایی',
  [roomNoteBodyKey('the-archive')]: 'پل ریکور استدلال کرد که خود چیزی نیست که با درون‌نگری پیدایش کنید — روایتی است که پیوسته می‌سازیدش، طرحش را بازنویسی می‌کنید بی‌آنکه هرگز کتاب را تمام کنید. او این را هویت روایی نامید: برخلاف یک شیء صرف، که یکسانی‌اش در تغییرنکردن است، یکسانیِ یک خود در توانایی تغییرکردن و همچنان همان داستان نامیدنش نهفته است. این اتاق همان رویارویی‌ای را برپا می‌کند که نظریه‌ی ریکور برای دوام‌آوردن در برابرش ساخته شده بود: کنشی مشخص، تاریخ‌دار، بایگانی‌شده، که سرد به شما بازخوانده می‌شود، بدون فصل‌های اطرافش که آن را در آن لحظه اجتناب‌ناپذیر جلوه می‌دادند. مالکیتش را پذیرفتن، انکارش کردن، و بی‌حکم بایگانی‌اش کردن سه رابطه‌ی متفاوت با تألیف‌اند — و پاسخ خود ریکور به سومی نزدیک‌تر است تا هرکدام از دو تای اول. موظف نیستید هنوز هر جمله‌ای را که نوشته‌اید تأیید کنید. فقط باید بپذیرید که هنوز شمایید که قلم را در دست دارید.',
});

// ---------- Act V: The Unchosen ----------
registerAll('v2', 'fa', {
  [roomBeatKey('the-unchosen', 0, 0)]: 'راهرویی که به‌یاد نمی‌آورید از آن گذشته باشید، با درهایی که کمی باز مانده‌اند — نه به‌شکل دعوت‌کننده. فقط باز، همان‌طور که دری باز می‌ماند وقتی مدتی طولانی کسی زحمت بستنش را به خود نداده.',
  [roomBeatKey('the-unchosen', 0, 1)]: 'این‌ها درهای همان راهی هستند که در آخرین عبورتان از اینجا هرگز از آن‌ها نگذشتید. مجموعه آن‌ها را دقیقاً همان‌طور که رهایشان کردید نگه داشته: واردنشده، تصمیم‌ناگرفته، از نظر فنی هنوز در دسترس، به همان شکلی که قطاری ازدست‌رفته هنوز، از نظر فنی، یک قطار است.',
  [roomBeatKey('the-unchosen', 0, 4)]: 'نگهبان: زیاد به این‌که کدام‌یک است فکر نمی‌کردم. یا برعکس، کاملاً فکر می‌کردم — هرگز نتوانسته‌ام تصمیم بگیرم کدام توصیه بدتر است.',
  [roomChoiceTextKey('the-unchosen', 'enter-it')]: 'آن را باقی راه هل بدهید تا کاملاً باز شود. بروید تو.',
  [roomChoiceHintKey('the-unchosen', 'enter-it')]: 'کنجکاوی، دیر پاداش‌گرفته.',
  [roomChoiceOutcomeKey('the-unchosen', 'enter-it', 1)]: 'هرچه قرار بود اینجا اتفاق بیفتد، ظاهراً از قبل افتاده — برای کسی، یا برای هیچ‌کس، یا آن پرسش صرفاً منقضی شده، همان‌طور که نامه‌ی بازنشده روزی از فوریت می‌افتد. کوچک‌تر از آن چیزی است که در ذهنتان ساخته بودید. بیشتر چیزهای نزیسته همین‌طورند.',
  [roomChoiceOutcomeKey('the-unchosen', 'enter-it', 2)]: 'نگهبان: این نرخِ دری است که بسته رها شده. نه تراژدی — فقط اتاقی، منتظرِ فراتر از فرصت خودش. برخی مسافران در این آرامش می‌یابند.',
  [roomChoiceTextKey('the-unchosen', 'close-it')]: 'آن را باقی راه ببندید. بعضی درها صادقانه بهتر است در بمانند.',
  [roomChoiceHintKey('the-unchosen', 'close-it')]: 'به گذشته‌بودنش احترام بگذارید.',
  [roomChoiceOutcomeKey('the-unchosen', 'close-it', 0)]: 'آرام آن را می‌بندید، همان‌طور که دری را به اتاقی می‌بندید که بالاخره، واقعاً، کسی در آن خوابیده.',
  [roomChoiceOutcomeKey('the-unchosen', 'close-it', 1)]: 'نگهبان: غریزه‌ی درستی است، می‌شود گفت. هر دری که باز نشده حسرتی در انتظار نیست. بعضی‌ها صرفاً درهایی‌اند که از همان بار اول درست بود رهایشان کنید، چه آن‌موقع می‌دانستید چه نه.',
  [roomChoiceTextKey('the-unchosen', 'read-the-hinges')]: '«چرا الان، از همه‌ی زمان‌ها، دوباره باز می‌شوی؟» از خودِ در بپرسید.',
  [roomChoiceHintKey('the-unchosen', 'read-the-hinges')]: 'خودِ پیشنهاد را بازجویی کنید، نه فقط اتاق را.',
  [roomChoiceOutcomeKey('the-unchosen', 'read-the-hinges', 0)]: 'پاسخی دقیق نمی‌گیرید — درها، حتی اینجا، طبیعتاً حرف‌زن نیستند — اما متوجه می‌شوید لولاها تازه روغن‌کاری شده‌اند. کسی، یا چیزی، می‌خواسته این در امشب، دقیقاً، به‌آسانی حرکت کند.',
  [roomChoiceOutcomeKey('the-unchosen', 'read-the-hinges', 1)]: 'نگهبان: پرسش منصفانه‌ای است، و نسخه‌ی صادقانه‌ی پاسخ را ندارم. بهترین حدسم: مجموعه دری را به شما پیشنهاد می‌دهد که حالا آماده‌اید بدون بازکردنش دوام بیاورید. زمان‌بندی‌اش را هرگز حتی به من هم توضیح نداده.',
  [roomNoteTitleKey('the-unchosen')]: 'راهی که نرفته شد، بازرسی‌شده',
  [roomNoteThinkersKey('the-unchosen')]: 'سورن کی‌یرکگور · رابرت فراست، شعری که به‌اشتباه احتیاط خوانده شد',
  [roomNoteBodyKey('the-unchosen')]: 'سورن کی‌یرکگور امکان را سرگیجه‌آورترین چیز در دسترس یک انسان نامید — سرگیجه‌آورتر از هر خطر واقعی، چون واقعی دست‌کم متناهی است، درحالی‌که امکان، هرچه بیشتر بر سرِ دوراهی بمانید و از انتخاب امتناع کنید، بی‌حد و مرز تکثیر می‌شود. اضطراب، برای کی‌یرکگور، حسِ آزادی است که به پایین نگاه می‌کند. شعر «راهی که نرفته شد»ی رابرت فراست تقریباً در هر مراسم فارغ‌التحصیلی به‌عنوان سرودی برای انحراف شجاعانه بد خوانده می‌شود — «آن یکی که کمتر پیموده شده بود، / و همین همه‌چیز را تغییر داد» — اما خودِ شعر بسیار زیرکانه‌تر است: دو راه، همان‌طور که راوی دو بند پیش‌تر اعتراف می‌کند، «واقعاً تقریباً یکسان» فرسوده بودند، و آه حسرت‌بار پایانی از پیش به‌عنوان چیزی اعتراف می‌شود که راوی «با آهی / جایی در سال‌های سال‌های بعد» تعریف خواهد کرد — داستانی که با گذشت‌نگری بازسازی شده، نه حقیقتی که از سرِ دوراهی گزارش شده باشد. درهای این راهرو هرگز مخفیانه بهتر نبودند. آن‌ها صرفاً، برای لحظه‌ای، ممکن بودند — و امکان، همین‌که بسته شود، هیچ رسیدی نگه نمی‌دارد، فقط شایعه.',
});

// ---------- Act V: The Echo ----------
registerAll('v2', 'fa', {
  [roomBeatKey('the-echo', 0, 0)]: 'اتاقی خالی. دو صندلی، رو‌به‌روی هم، آن‌قدر نزدیک که واضح است هرکه روی هرکدام بنشیند، قرار است شنیده شود.',
  [roomBeatKey('the-echo', 0, 1)]: 'صندلیِ دیگر اشغال شده. نه توسط یک شخص — اتاق در این‌باره دقیق است، دقیق به شکلی که فقط مکانی بی‌نیاز از دروغ‌گفتن می‌تواند باشد — بلکه توسط صدایی، صبورانه ساخته‌شده از آنچه آخرین‌باری که اینجا بودید گفتید و انتخاب کردید.',
  [roomBeatKey('the-echo', 0, 5)]: 'نگهبان: من در این یکی نمی‌نشینم. هرکاری شما دو نفر آن‌تو می‌کنید، هرگز وظیفه‌ی من نبوده که داوری‌اش کنم.',
  [roomChoiceTextKey('the-echo', 'answer-it')]: '«صدایت را می‌شنوم.» با کسی که بودید حرف بزنید.',
  [roomChoiceHintKey('the-echo', 'answer-it')]: 'مخاطبش قرار دهید، نه فقط شاهدش باشید.',
  [roomChoiceOutcomeKey('the-echo', 'answer-it', 0)]: 'آن را می‌گویید — نه اصلاحی، نه عذرخواهی، فقط تصدیقی، همان‌طور که کسی را دم دری خوش‌آمد می‌گویید که مطمئن نبودید هنوز بشناسدتان.',
  [roomChoiceOutcomeKey('the-echo', 'answer-it', 1)]: 'صندلی دیگر دقیقاً پاسخ نمی‌دهد. اما چیزی در اتاق آرام می‌گیرد، همان‌طور که نفسی حبس‌شده وقتی بالاخره عمداً رها می‌شود، آرام می‌گیرد — این‌بار توسط دو نفر به‌جای یکی.',
  [roomChoiceTextKey('the-echo', 'sit-in-silence')]: 'روبه‌رویش بنشینید و چیزی نگویید. بگذارید این‌بار، بی‌وقفه، حرفش را تمام کند.',
  [roomChoiceHintKey('the-echo', 'sit-in-silence')]: 'شاهد باشید، نه پاسخ‌دهنده.',
  [roomChoiceOutcomeKey('the-echo', 'sit-in-silence', 0)]: 'می‌نشینید. می‌گذارید تا انتها حرف بزند، بدون اصلاح حتی یک کلمه — که متوجه می‌شوید، حتی بار اول هم همیشه از پسش برنمی‌آمدید.',
  [roomChoiceOutcomeKey('the-echo', 'sit-in-silence', 1)]: 'آن سکوت خالی نیست. اگر چیزی باشد، کامل‌ترین چیزی است که در آن اتاق گفته شده.',
  [roomChoiceTextKey('the-echo', 'take-both-chairs')]: '«هرگز کس دیگری اینجا نبود.» به‌نوبت روی هر دو صندلی بنشینید، و منظورتان را داشته باشید.',
  [roomChoiceHintKey('the-echo', 'take-both-chairs')]: 'گران‌ترین خوانش: هیچ میهمانی نیست، فقط شما.',
  [roomChoiceOutcomeKey('the-echo', 'take-both-chairs', 0)]: 'روی صندلی دوم هم، لحظه‌ای، می‌نشینید و آن صدا را مثل کتی که زمانی داشتید امتحان می‌کنید — و دقیقاً اندازه است، که یا دلگرم‌کننده است یا کل مشکل، بسته به ساعت.',
  [roomChoiceOutcomeKey('the-echo', 'take-both-chairs', 1)]: 'هرگز میهمانی برای سرگرم‌کردن اینجا نبود. فقط سلسله‌ای از شما، بایگانی‌شده زیر یک نام، که به‌نوبت قلم را در دست می‌گرفتند.',
  [roomNoteTitleKey('the-echo')]: 'گفت‌وگو با مستأجر پیشین',
  [roomNoteThinkersKey('the-echo')]: 'دیوید هیوم · گیلن استراوسن، خودِ بسته‌ای و منتقدانش',
  [roomNoteBodyKey('the-echo')]: 'دیوید هیوم در ذهن خودش به‌دنبال خودی پیوسته گشت و نتیجه‌ای صفر و مشهور گزارش داد: هر بار درون‌نگری کرد، فقط دسته‌ای از ادراکات یافت — نه هیچ رشته‌ای که زیرشان جاری باشد، فقط یک تجربه پس از دیگری، به‌قدری فشرده که حس یک شخص را می‌داد. گیلن استراوسن آن دسته را به‌عنوان توصیفی از خودِ تجربه جدی گرفت: بسیاری از ما، او استدلال کرد، در واقع با کسی که سال‌ها یا حتی ساعت‌ها پیش بودیم پیوسته حس نمی‌کنیم — خودِ روان‌شناختی اغلب «رویدادی» است، خودش را در انفجارهایی کوتاه‌تر و محلی‌تر از آنچه مدل هویت روایی فرض می‌کند، تازه می‌کند، بی‌آنکه هیچ رشته‌ی واحدی لازم باشد تا هر انفجاری را خودی واقعی سازد. صدای روی صندلی دیگر شبح نیست؛ آن چیزی است که از چنین انفجاری باقی مانده، دقیق و بی‌بدخواهی بایگانی شده. چه پاسخش دهید، چه صبر کنید تا تمام شود، چه بپذیرید که همیشه فقط یک ساکن بوده، اتاق همان پرسش را به سه شکل می‌پرسد: آیا کسی که اکنون گوش می‌دهد همان کسی است که آن‌موقع سخن می‌گفت — یا صرفاً مستأجر بعدی، که اجاره‌نامه‌ی پیشین را با دقتی غیرمعمول می‌خواند؟',
});

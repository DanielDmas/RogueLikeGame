{
  "name": "vestibule",
  "private": true,
  "version": "1.0.0-rc.1",
  "description": "The Vestibule — a collection of 2.5D roguelikes sharing one engine: ANAMNESIS (finding your way back to yourself) and LIMERENCE (relationships at their breaking points).",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build:manifest": "node scripts/build-voice-manifest.mjs",
    "predev": "npm run build:manifest",
    "dev": "vite",
    "predev:limerence": "npm run build:manifest",
    "dev:limerence": "vite --mode limerence",
    "prebuild": "npm run build:manifest",
    "build": "tsc --noEmit && vite build",
    "prebuild:anamnesis": "npm run build:manifest",
    "build:anamnesis": "tsc --noEmit && vite build --outDir dist-web/anamnesis",
    "prebuild:limerence": "npm run build:manifest",
    "build:limerence": "tsc --noEmit && vite build --mode limerence --outDir dist-web/limerence",
    "build:web": "npm run build:anamnesis && npm run build:limerence && node scripts/assemble-web-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "electron .",
    "predist:win": "npm run build:web",
    "dist:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/spectral": "^5.1.0",
    "@fontsource/vazirmatn": "^5.2.8",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.61.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.anamnesis.thevestibule",
    "productName": "The Vestibule",
    "files": [
      "dist-web/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TheVestibule-${version}-win-x64.exe"
    }
  }
}

{
  "name": "anamnesis",
  "private": true,
  "version": "0.2.4-beta",
  "description": "The Vestibule — a collection of 2.5D roguelikes sharing one engine: ANAMNESIS (finding your way back to yourself) and LIMERENCE (relationships at their breaking points).",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:limerence": "vite --mode limerence",
    "build": "tsc --noEmit && vite build",
    "build:anamnesis": "tsc --noEmit && vite build --outDir dist-web/anamnesis",
    "build:limerence": "tsc --noEmit && vite build --mode limerence --outDir dist-web/limerence",
    "build:web": "npm run build:anamnesis && npm run build:limerence && node scripts/assemble-web-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "electron .",
    "dist:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/spectral": "^5.1.0",
    "@fontsource/vazirmatn": "^5.2.8",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.61.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.anamnesis.game",
    "productName": "ANAMNESIS",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ANAMNESIS-${version}-win-x64.exe"
    }
  }
}

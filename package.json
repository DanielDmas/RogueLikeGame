{
  "name": "anamnesis",
  "private": true,
  "version": "0.1.0",
  "description": "A 2.5D philosophical roguelike about finding your way back to yourself.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "electron .",
    "dist:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/spectral": "^5.1.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.anamnesis.game",
    "productName": "ANAMNESIS",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "ANAMNESIS-${version}-win-x64.exe"
    }
  }
}
